# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/legacy-doc-generator

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRE=30d

# ============================================
# AI SERVICE CONFIGURATION
# ============================================
# AI Provider: 'openai' | 'gemini' | 'both'
AI_SERVICE_PROVIDER=openai
AI_SERVICE_FALLBACK=true

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000

# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=4000

# ============================================
# CLOUD STORAGE CONFIGURATION
# ============================================
# Storage Provider: 'local' | 'oracle_cloud' | 'aws_s3' | 'azure_blob'
STORAGE_PROVIDER=local

# Oracle Cloud Object Storage
OCI_NAMESPACE=
OCI_BUCKET_NAME=legacy-doc-storage
OCI_REGION=us-phoenix-1
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_PUBLIC_URL_EXPIRY=3600

# AWS S3 (for future use)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_URL_EXPIRY=3600

# Azure Blob Storage (for future use)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER_NAME=
AZURE_URL_EXPIRY=3600

# Google Cloud Storage (for future use)
GCP_PROJECT_ID=
GCP_BUCKET_NAME=
GCP_KEY_FILE_PATH=
GCP_URL_EXPIRY=3600

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=524288000
UPLOAD_PATH=./uploads
TEMP_PATH=./temp
STORAGE_PATH=./storage

# ============================================
# SECURITY CONFIGURATION
# ============================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================
# EMAIL CONFIGURATION
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@legacydocgenerator.com
SENDGRID_FROM_NAME=Legacy Doc Generator

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=http://localhost:3000
