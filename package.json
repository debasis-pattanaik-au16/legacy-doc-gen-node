{
  "name": "legacy-doc-generator-backend",
  "version": "1.0.0",
  "description": "Backend API for Legacy System Documentation Generator",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "test": "jest",
    "test:storage": "ts-node -r tsconfig-paths/register src/scripts/test-storage.ts",
    "test:oracle": "ts-node -r tsconfig-paths/register src/scripts/test-oracle-upload.ts",
    "test:cloud-model": "ts-node -r tsconfig-paths/register src/scripts/test-cloud-storage-model.ts",
    "test:phase4": "ts-node -r tsconfig-paths/register src/scripts/test-phase4-integration.ts",
    "test:phase5-api": "ts-node -r tsconfig-paths/register src/scripts/test-phase5-api.ts",
    "migrate:cloud-storage": "ts-node -r tsconfig-paths/register src/scripts/add-cloud-storage-fields.ts",
    "migrate:verify": "ts-node -r tsconfig-paths/register src/scripts/add-cloud-storage-fields.ts verify",
    "migrate:user-settings": "ts-node -r tsconfig-paths/register src/scripts/migrate-user-settings.ts",
    "migrate:user-settings:verify": "ts-node -r tsconfig-paths/register src/scripts/migrate-user-settings.ts verify",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "legacy",
    "documentation",
    "ai",
    "code-analysis"
  ],
  "author": "Legacy Doc Generator Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.5",
    "@types/archiver": "^6.0.3",
    "@types/marked": "^6.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^12.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "oci-sdk": "^2.118.1",
    "openai": "^4.20.1",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__parser": "^7.1.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/sendgrid": "^4.3.0",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
